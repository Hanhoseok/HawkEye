# phone-scan-checkout 폴더 전용 규칙 (경로는 이 폴더 기준)

# --- 의존성 (npm install 로 다시 받음) ---
node_modules/

# --- 실행 데이터: SQLite DB (상품·주문·공개 주소 설정). 서버가 없으면 자동 생성 ---
data/
*.db
*.db-shm
*.db-wal
*.sqlite

# --- HTTPS 자체 서명 인증서·개인 키 ---
certs/
*.pem
*.key
*.crt

# --- 환경변수 (PUBLIC_URL 등) ---
.env
*.env

# --- 로그·테스트 산출물 ---
*.log
npm-debug.log*
coverage/

# --- 편집기·OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
