# 주의: .gitignore 는 줄 중간의 '#' 을 주석으로 보지 않는다.
# 설명은 반드시 패턴 위쪽의 별도 줄에 적을 것.

# ── 비밀정보 ───────────────────────────────────────────────────
# RTSP 계정/비밀번호가 들어 있다. 절대 커밋하지 말 것.
.env

# ── 가상환경 / 파이썬 산출물 (약 5 GB) ─────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo

# ── AI-Hub 원본 배포본 (약 138 GB) ─────────────────────────────
238-1.*/
238-2.*/

# ── 코드로 다시 만들 수 있는 생성물 ────────────────────────────
# data/raw        압축 푼 mp4/xml  약 413 GB
# data/cache      프레임 캐시 .npy 약 59 GB
# data/cache_jpz  프레임 캐시 .jpz 약 18 GB
# colab_upload    Colab 업로드 묶음 약 18 GB
data/raw/
data/cache/
data/cache_jpz/
data/samples/
data/events/
colab_upload/

# 인덱스는 재생성된다. clips.jsonl 은 15 MB 라 빼고
# 분할 목록과 캐시 메타만 남겨 재현성을 확보한다.
data/index/*
!data/index/splits.json
!data/index/cache_meta.json

# ── 모델 가중치 ────────────────────────────────────────────────
# 깃허브는 파일 하나가 100 MB 를 넘으면 거부한다.
# best.pt 120~359 MB, last.pt 359 MB → Releases 에 첨부할 것.
# 평가 결과(JSON)와 학습 로그는 근거 자료이므로 올린다.
*.pt
*.pth
*.onnx
*.ckpt

# ── 임시 / 작업 파일 ───────────────────────────────────────────
*.part
*.tmp
*.npy.part
*.irx*

# ── OS / 편집기 ────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
